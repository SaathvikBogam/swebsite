---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { contentSlug } from "../../lib/contentSlug";

// Fallback: load MDX files directly so the page works even if `astro:content` is unavailable
const modules = import.meta.glob("../../content/journey/*.mdx", { eager: true });
const entries = Object.entries(modules)
  .map(([path, mod]) => {
    const file = path.split("/").pop();
    const id = file.replace(/\.mdx$/, "");
    const data = mod.frontmatter ?? mod.metadata ?? {};
    // coerce date to Date
    if (data.date) data.date = new Date(data.date);
    return { id, mod, data };
  })
  .sort((a, b) => b.data.date - a.data.date);
---
<BaseLayout title="Journey" description="Milestones along my undergraduate path." pageClass="journey-page">
  <header class="journey-hero">
    <h1>Journey</h1>
    <p>This page tracks my academic journey — a running log of my research, coding projects, and campus life. From late-night lab experiments to personal builds, here’s a look at how I’m exploring science and problem-solving along the way.</p>
  </header>

  <section class="journey-list">
    <h2 class="journey-section-title">BSMS at IISER Bhopal</h2>
    {entries.length === 0 ? (
      <p class="empty">No entries yet.</p>
    ) : (
      <ul>
        {entries.map((e) => (
          <li class="timeline-item">
            <div class="timeline-marker" aria-hidden="true"></div>
            <div class="timeline-card">
              <span class="journey-date">
                <time datetime={e.data.date.toISOString()}>
                  {e.data.date.toLocaleDateString("en-IN", { year: "numeric", month: "short", day: "numeric" })}
                </time>
              </span>
              <span class="journey-event">{e.data.title}</span>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
  </BaseLayout>

  <style>
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideInFromLeft {
      from {
        opacity: 0;
        transform: translateX(-20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes scaleIn {
      from {
        opacity: 0;
        transform: scale(0.9);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .journey-hero {
      max-width: 60ch;
      margin-bottom: 3rem;
    }

    .journey-hero h1 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 3.5rem);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.02em;
      animation: fadeInUp 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    .journey-hero p {
      margin: 1.25rem 0 0;
      color: var(--muted);
      max-width: 54ch;
      font-size: 1.05rem;
      line-height: 1.75;
      animation: fadeInUp 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s forwards;
      opacity: 0;
    }

    .journey-list {
      margin-top: 3.5rem;
      position: relative;
      max-width: 52rem;
    }

    .journey-section-title {
      margin: 0 0 2rem;
      font-size: 1.4rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--fg);
      animation: fadeInUp 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s forwards;
      opacity: 0;
    }

    .journey-list ul {
      list-style: none;
      margin: 0;
      padding: 0;
      position: relative;
      padding-left: 2.5rem;
    }

    .journey-list ul::before {
      content: "";
      position: absolute;
      left: 0.85rem;
      top: 1rem;
      bottom: 0;
      width: 2px;
      background: linear-gradient(
        180deg,
        rgba(168, 216, 200, 0.6),
        rgba(168, 216, 200, 0.2),
        rgba(255, 255, 255, 0.05)
      );
      animation: slideInFromLeft 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s forwards;
      opacity: 0;
    }

    .timeline-item {
      position: relative;
      margin-bottom: 1.5rem;
      padding-left: 0;
      transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      animation: slideInFromLeft 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      opacity: 0;
    }

    .timeline-item:nth-child(1) {
      animation-delay: 0.3s;
    }

    .timeline-item:nth-child(2) {
      animation-delay: 0.4s;
    }

    .timeline-item:nth-child(3) {
      animation-delay: 0.5s;
    }

    .timeline-item:nth-child(n + 4) {
      animation-delay: 0.6s;
    }

    .timeline-marker {
      position: absolute;
      left: -1.6rem;
      top: 2.5rem;
      width: 1.1rem;
      height: 1.1rem;
      border-radius: 50%;
      background: var(--accent);
      box-shadow:
        0 0 0 5px rgba(168, 216, 200, 0.15),
        0 0 12px rgba(168, 216, 200, 0.4),
        inset -1px -1px 3px rgba(0, 0, 0, 0.2);
      transform: translateX(-50%);
      z-index: 2;
      transition: all 0.3s ease;
    }

    .timeline-card {
      margin-left: 1.5rem;
      padding: 1.25rem 1.4rem;
      border: 1px solid var(--border);
      border-left: 3px solid var(--accent);
      border-radius: 1rem;
      background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.05) 0%,
        rgba(255, 255, 255, 0.02) 100%
      );
      backdrop-filter: blur(2px);
      box-shadow:
        0 4px 16px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
      display: grid;
      gap: 0.5rem;
      transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .timeline-item:hover .timeline-card {
      border-color: rgba(168, 216, 200, 0.4);
      background: linear-gradient(
        135deg,
        rgba(168, 216, 200, 0.08) 0%,
        rgba(255, 255, 255, 0.04) 100%
      );
      box-shadow:
        0 8px 24px rgba(168, 216, 200, 0.15),
        0 4px 16px rgba(0, 0, 0, 0.25),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      transform: translateX(4px);
    }

    .timeline-item:hover .timeline-marker {
      box-shadow:
        0 0 0 6px rgba(168, 216, 200, 0.25),
        0 0 20px rgba(168, 216, 200, 0.6),
        inset -1px -1px 3px rgba(0, 0, 0, 0.2);
      transform: translateX(-50%) scale(1.15);
    }

    .journey-date {
      color: var(--accent);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      line-height: 1.3;
      opacity: 0.95;
      transition: opacity 0.3s ease;
    }

    .journey-event {
      display: block;
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--fg);
      line-height: 1.6;
      letter-spacing: -0.01em;
      transition: color 0.3s ease;
    }

    .timeline-item:hover .journey-date {
      opacity: 1;
    }

    .timeline-item:hover .journey-event {
      color: #f0f0f0;
    }

    .empty {
      color: var(--muted);
      font-style: italic;
    }

    @media (max-width: 768px) {
      .journey-hero {
        margin-bottom: 2.5rem;
      }

      .journey-hero h1 {
        font-size: clamp(1.75rem, 3.5vw, 2.5rem);
      }

      .journey-hero p {
        font-size: 1rem;
        margin-top: 1rem;
      }

      .journey-list {
        margin-top: 3rem;
        max-width: 100%;
      }

      .journey-section-title {
        font-size: 1.3rem;
        margin-bottom: 1.75rem;
      }

      .journey-list ul {
        padding-left: 2rem;
      }

      .journey-list ul::before {
        left: 0.65rem;
      }

      .timeline-marker {
        left: 0.65rem;
        width: 1rem;
        height: 1rem;
        top: 1.7rem;
      }

      .timeline-card {
        margin-left: 1.25rem;
        padding: 1.1rem 1.2rem;
      }

      .timeline-item:hover .timeline-card {
        transform: translateX(2px);
      }
    }

    @media (max-width: 640px) {
      .journey-hero h1 {
        font-size: clamp(1.5rem, 3vw, 2rem);
      }

      .journey-hero p {
        font-size: 0.95rem;
      }

      .journey-section-title {
        font-size: 1.2rem;
        margin-bottom: 1.5rem;
      }

      .journey-list {
        margin-top: 2.5rem;
      }

      .journey-list ul {
        padding-left: 1.5rem;
      }

      .journey-list ul::before {
        left: 0.45rem;
      }

      .timeline-marker {
        left: 0.45rem;
        width: 0.9rem;
        height: 0.9rem;
        top: 1.65rem;
      }

      .timeline-card {
        margin-left: 1rem;
        padding: 1rem;
        gap: 0.4rem;
      }

      .journey-date {
        font-size: 0.8rem;
      }

      .journey-event {
        font-size: 1rem;
      }

      .timeline-item:hover .timeline-card {
        transform: translateX(0px);
      }

      .timeline-item:hover .timeline-marker {
        transform: translateX(-50%) scale(1.1);
      }
    }
  </style>
