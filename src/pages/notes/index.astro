---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { contentSlug } from "../../lib/contentSlug";
import { sitePath } from "../../lib/sitePath";

// Load MDX note modules directly as a fallback to astro:content
const modules = import.meta.glob("../../content/notes/*.mdx", { eager: true });
const notes = Object.entries(modules)
  .map(([path, mod]) => {
    const file = path.split("/").pop();
    const id = file.replace(/\.mdx$/, "");
    const data = mod.frontmatter ?? mod.metadata ?? {};
    return { id, data, Content: mod.default };
  })
  .filter((n) => !n.data.draft)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const defaultImage = sitePath("/images/notes/vector-calculus.svg");
---

<BaseLayout title="Notes" description="Lecture notes and write-ups." wide>
  <div class="notes-page">
    <h1 class="notes-page-title">Notes</h1>

    <ul class="notes-cards">
      {
        notes.map((n) => (
            <li>
              <details class="note-card">
                <summary class="note-card-summary">
                  <img
                    class="note-card-image"
                    src={sitePath(n.data.image ?? defaultImage)}
                    alt=""
                    width="140"
                    height="140"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="note-card-body">
                    <h2 class="note-card-title">{n.data.title}</h2>
                    <p class="note-card-desc">{n.data.description}</p>
                  </div>
                </summary>
                <div class="note-card-expanded">
                  {n.data.pdf && (
                    <p class="pdf-link">
                      <a href={sitePath(n.data.pdf)}>Download PDF</a>
                    </p>
                  )}
                  <n.Content />
                </div>
              </details>
            </li>
          ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes expandContent {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes cardOpen {
    from {
      transform: perspective(1000px) rotateX(2deg);
    }
    to {
      transform: perspective(1000px) rotateX(0deg);
    }
  }

  @keyframes shimmer {
    0% {
      background-position: -1000px 0;
    }
    100% {
      background-position: 1000px 0;
    }
  }

  .notes-page {
    --notes-card-bg: #262614;
    --notes-card-border: rgba(180, 200, 170, 0.12);
    --notes-heading: #a8d8c8;
    --notes-desc: #a39e90;
  }

  .notes-page-title {
    margin-bottom: 2.5rem;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--notes-heading);
    line-height: 1.1;
    animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .notes-cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .notes-cards li {
    animation: fadeInUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    opacity: 0;
  }

  .notes-cards li:nth-child(1) {
    animation-delay: 0.1s;
  }

  .notes-cards li:nth-child(2) {
    animation-delay: 0.2s;
  }

  .notes-cards li:nth-child(3) {
    animation-delay: 0.3s;
  }

  .notes-cards li:nth-child(4) {
    animation-delay: 0.4s;
  }

  .notes-cards li:nth-child(5) {
    animation-delay: 0.5s;
  }

  .notes-cards li:nth-child(n + 6) {
    animation-delay: 0.6s;
  }

  .note-card {
    background: linear-gradient(
      135deg,
      rgba(38, 38, 20, 0.95) 0%,
      rgba(38, 38, 20, 0.85) 100%
    );
    border: 1px solid var(--notes-card-border);
    border-radius: 1.5rem;
    overflow: hidden;
    transition:
      border-color 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      box-shadow 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      background 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .note-card:hover {
    border-color: rgba(168, 216, 200, 0.5);
    box-shadow:
      0 8px 32px rgba(168, 216, 200, 0.12),
      0 4px 16px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    background: linear-gradient(
      135deg,
      rgba(38, 38, 20, 1) 0%,
      rgba(42, 42, 24, 0.95) 100%
    );
  }

  .note-card-summary {
    display: flex;
    gap: 1.5rem;
    align-items: stretch;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    color: inherit;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    padding-right: 4rem;
  }

  .note-card-summary:hover {
    background: rgba(168, 216, 200, 0.03);
  }

  .note-card-summary:active {
    transform: scale(0.995);
  }

  .note-card-summary::-webkit-details-marker {
    display: none;
  }

  .note-card-summary::after {
    content: "";
    position: absolute;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1.5rem;
    height: 1.5rem;
    background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="rgba(168,216,200,0.5)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>') no-repeat center;
    background-size: contain;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .note-card[open] .note-card-summary::after {
    transform: translateY(-50%) rotateZ(180deg);
  }

  .note-card[open] {
    border-color: rgba(168, 216, 200, 0.4);
    background: linear-gradient(
      135deg,
      rgba(38, 38, 20, 1) 0%,
      rgba(42, 42, 24, 0.97) 100%
    );
    box-shadow:
      0 8px 32px rgba(168, 216, 200, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    animation: cardOpen 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .note-card[open] .note-card-summary {
    background: rgba(168, 216, 200, 0.06);
  }

  .note-card-image {
    flex-shrink: 0;
    width: 8.5rem;
    height: 8.5rem;
    object-fit: contain;
    border-radius: 1rem;
    background: rgba(18, 24, 16, 0.8);
    border: 1px solid rgba(168, 216, 200, 0.1);
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .note-card:hover .note-card-image {
    border-color: rgba(168, 216, 200, 0.25);
    box-shadow: 0 4px 16px rgba(168, 216, 200, 0.1);
    transform: scale(1.05);
  }

  .note-card-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.25rem 0;
    flex: 1;
  }

  .note-card-title {
    margin: 0 0 0.65rem;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--notes-heading);
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .note-card:hover .note-card-title {
    color: #c8f0e0;
  }

  .note-card-desc {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--notes-desc);
    transition: color 0.3s ease;
  }

  .note-card:hover .note-card-desc {
    color: #b5a89a;
  }

  .note-card-expanded {
    padding: 1.5rem 1.5rem 1.5rem;
    color: var(--text);
    border-top: 1px solid rgba(168, 216, 200, 0.08);
    background: rgba(0, 0, 0, 0.15);
    animation: expandContent 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .pdf-link {
    margin: 0 0 1.25rem;
    padding: 0.75rem 1rem;
    background: rgba(168, 216, 200, 0.08);
    border: 1px solid rgba(168, 216, 200, 0.2);
    border-radius: 0.8rem;
    display: inline-block;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .pdf-link:hover {
    background: rgba(168, 216, 200, 0.15);
    border-color: rgba(168, 216, 200, 0.35);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(168, 216, 200, 0.15);
  }

  .pdf-link a {
    color: var(--notes-heading);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.3s ease;
  }

  .pdf-link:hover a {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .note-card-summary {
      gap: 1.25rem;
      padding: 1.1rem 1.3rem;
      padding-right: 3.5rem;
    }

    .note-card-summary::after {
      right: 1.3rem;
      width: 1.3rem;
      height: 1.3rem;
    }

    .note-card-image {
      width: 7.5rem;
      height: 7.5rem;
    }

    .note-card:hover .note-card-image {
      transform: scale(1.03);
    }

    .note-card-expanded {
      padding: 1.25rem 1.3rem 1.25rem;
    }
  }

  @media (max-width: 520px) {
    .notes-page-title {
      margin-bottom: 2rem;
    }

    .notes-cards {
      gap: 1rem;
    }

    .note-card {
      border-radius: 1.25rem;
    }

    .note-card-summary {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1rem 1rem 1rem 1rem;
      padding-right: 3.5rem;
    }

    .note-card-summary:active {
      transform: scale(1);
    }

    .note-card-summary::after {
      right: 1rem;
      width: 1.2rem;
      height: 1.2rem;
    }

    .note-card-image {
      width: 100%;
      height: auto;
      max-height: 10rem;
      aspect-ratio: 16 / 10;
    }

    .note-card:hover .note-card-image {
      transform: scale(1);
    }

    .note-card-body {
      width: 100%;
    }

    .note-card-title {
      font-size: 1.2rem;
      margin-bottom: 0.5rem;
    }

    .note-card-expanded {
      padding: 1.1rem;
    }

    .pdf-link {
      width: 100%;
      text-align: center;
    }

    .pdf-link:hover {
      transform: translateY(0);
    }
  }
</style>
