---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sitePath } from "../../lib/sitePath";

export async function getStaticPaths() {
  const modules = import.meta.glob("../../content/notes/*.mdx");
  const paths = Object.keys(modules).map((p) => p.split("/").pop().replace(/\.mdx$/, ""));
  return paths.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug;
const modules = import.meta.glob("../../content/notes/*.mdx");
const match = Object.keys(modules).find((p) => p.split("/").pop().replace(/\.mdx$/, "") === slug);
if (!match) throw new Error(`Note not found: ${slug}`);
const mod = await modules[match]();
const post = { id: slug, data: mod.frontmatter ?? mod.metadata ?? {} };
if (post.data.date) post.data.date = new Date(post.data.date);
const Content = mod.default;
---

<BaseLayout title={post.data.title}>
  <article>
    {(post.data.date || post.data.course) && (
      <p class="meta">
        {post.data.date && (
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString("en-IN", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        )}
        {post.data.date && post.data.course && " · "}
        {post.data.course}
      </p>
    )}
    <h1>{post.data.title}</h1>
    {post.data.pdf && (
      <p class="pdf">
        <a href={sitePath(post.data.pdf)}>Download PDF</a>
        <span class="hint"> (compiled from LaTeX)</span>
      </p>
    )}
    <Content />
  </article>
</BaseLayout>

<style>
  .meta {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0 0 0.5rem;
  }

  .pdf {
    margin: 0 0 1rem;
    font-size: 0.95rem;
  }

  .hint {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
